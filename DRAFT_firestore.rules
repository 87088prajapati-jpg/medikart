rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Trusted server-provisioned Admin check (never trusts client-modifiable user profile fields)
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidCity(city) {
      return city is string && city in ['Bengaluru', 'Mumbai', 'New Delhi', 'Hyderabad', 'Chennai', 'Pune'];
    }

    function isValidExpiry(exp) {
      return exp is string && exp.size() == 7 && exp.matches('^(0[1-9]|1[0-2])\\/[0-9]{4}$');
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'city', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'fullName', 'phone', 'city', 'addressLine', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && isValidCity(data.city)
        && (!('addressLine' in data) || (data.addressLine is string && data.addressLine.size() <= 200))
        && data.role is string && data.role == 'customer'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: DemoCartItem
    function isValidDemoCartItem(data, userId, skuId) {
      return data.keys().hasAll(['skuId', 'userId', 'brandName', 'genericComposition', 'batchNumber', 'expiryMonthYear', 'mrpInr', 'quantity', 'updatedAt'])
        && data.keys().hasOnly(['skuId', 'userId', 'brandName', 'genericComposition', 'batchNumber', 'expiryMonthYear', 'mrpInr', 'quantity', 'updatedAt'])
        && data.skuId is string && data.skuId == skuId && isValidId(data.skuId)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 100
        && data.genericComposition is string && data.genericComposition.size() >= 1 && data.genericComposition.size() <= 160
        && data.batchNumber is string && data.batchNumber.size() >= 1 && data.batchNumber.size() <= 32 && data.batchNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidExpiry(data.expiryMonthYear)
        && data.mrpInr is number && data.mrpInr > 0 && data.mrpInr <= 100000
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 20
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: DemoRxDraft (Non-PHI demo markers only)
    function isValidDemoRxDraft(data, userId, draftId) {
      return data.keys().hasAll(['draftId', 'userId', 'title', 'sampleType', 'city', 'createdAt'])
        && data.keys().hasOnly(['draftId', 'userId', 'title', 'sampleType', 'city', 'note', 'createdAt'])
        && data.draftId is string && data.draftId == draftId && isValidId(data.draftId)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.sampleType is string && data.sampleType in ['sample_cardiac', 'sample_fever', 'local_preview_marker']
        && isValidCity(data.city)
        && (!('note' in data) || (data.note is string && data.note.size() <= 160))
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: InventorySku
    function isValidInventorySku(data, skuId) {
      return data.keys().hasAll(['skuId', 'brandName', 'genericComposition', 'manufacturer', 'category', 'schedule', 'mrpInr', 'updatedAt'])
        && data.keys().hasOnly(['skuId', 'brandName', 'genericComposition', 'manufacturer', 'category', 'schedule', 'mrpInr', 'updatedAt'])
        && data.skuId is string && data.skuId == skuId && isValidId(data.skuId)
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 100
        && data.genericComposition is string && data.genericComposition.size() >= 1 && data.genericComposition.size() <= 160
        && data.manufacturer is string && data.manufacturer.size() >= 1 && data.manufacturer.size() <= 100
        && data.category is string && data.category in [
          'Chronic & Cardiac',
          'Pain/Fever & Cold',
          'Vitamins & Immunity',
          'Ayurveda & Herbal',
          'Digestive & Gut',
          'Skin & Derma Care',
          'Devices & First Aid'
        ]
        && data.schedule is string && data.schedule in ['OTC', 'Schedule H Rx Required', 'Medical Device']
        && data.mrpInr is number && data.mrpInr > 0 && data.mrpInr <= 100000
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: InventoryBatch
    function isValidInventoryBatch(data, skuId, batchId) {
      return data.keys().hasAll(['batchId', 'skuId', 'batchNumber', 'expiryMonthYear', 'quantity', 'quarantined', 'updatedAt'])
        && data.keys().hasOnly(['batchId', 'skuId', 'batchNumber', 'expiryMonthYear', 'quantity', 'quarantined', 'updatedAt'])
        && data.batchId is string && data.batchId == batchId && isValidId(data.batchId)
        && data.skuId is string && data.skuId == skuId && isValidId(data.skuId)
        && data.batchNumber is string && data.batchNumber.size() >= 1 && data.batchNumber.size() <= 32 && data.batchNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidExpiry(data.expiryMonthYear)
        && data.quantity is int && data.quantity >= 0 && data.quantity <= 100000
        && data.quarantined is bool
        && data.updatedAt is timestamp;
    }

    // Users Collection (PII isolated to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'city', 'addressLine', 'updatedAt']);
      allow delete: if false;

      // Customer Demo Cart Items
      match /cartItems/{skuId} {
        allow get: if isValidId(userId) && isValidId(skuId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(skuId)
          && isOwner(userId)
          && isValidDemoCartItem(incoming(), userId, skuId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(skuId)
          && isOwner(userId)
          && isValidDemoCartItem(incoming(), userId, skuId)
          && incoming().skuId == existing().skuId
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'batchNumber', 'expiryMonthYear', 'mrpInr', 'brandName', 'genericComposition', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(skuId) && isOwner(userId);
      }

      // Customer Non-PHI Demo Rx Drafts
      match /rxDrafts/{draftId} {
        allow get: if isValidId(userId) && isValidId(draftId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(draftId)
          && isOwner(userId)
          && isValidDemoRxDraft(incoming(), userId, draftId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(draftId) && isOwner(userId);
      }
    }

    // Server-provisioned Admin records (clients can never list or modify)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && request.auth.uid == adminUid && request.auth.token.email_verified == true;
      allow list, create, update, delete: if false;
    }

    // Admin-only Inventory (completely inaccessible to customers)
    match /inventory/{skuId} {
      allow get: if isValidId(skuId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(skuId)
        && isAdmin()
        && isValidInventorySku(incoming(), skuId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(skuId)
        && isAdmin()
        && isValidInventorySku(incoming(), skuId)
        && incoming().skuId == existing().skuId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['brandName', 'genericComposition', 'manufacturer', 'category', 'schedule', 'mrpInr', 'updatedAt']);
      allow delete: if false;

      match /batches/{batchId} {
        allow get: if isValidId(skuId) && isValidId(batchId) && isAdmin();
        allow list: if isAdmin() && resource.data.skuId == skuId;
        allow create: if isValidId(skuId) && isValidId(batchId)
          && isAdmin()
          && isValidInventoryBatch(incoming(), skuId, batchId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/inventory/$(skuId));
        allow update: if isValidId(skuId) && isValidId(batchId)
          && isAdmin()
          && isValidInventoryBatch(incoming(), skuId, batchId)
          && incoming().batchId == existing().batchId
          && incoming().skuId == existing().skuId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['batchNumber', 'expiryMonthYear', 'quantity', 'quarantined', 'updatedAt']);
        allow delete: if false;
      }
    }
  }
}
